{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Packet RBX Documentation",
  "colors": {
    "primary": "#c740b6",
    "light": "#c685d6",
    "dark": "#591144"
  },
  "favicon": {
    "light": "/favicon.svg",
    "dark": "/favicon.svg"
  },
  "navigation": {
    "pages": [
      "untitled-page"
    ]
  },
  "logo": {
    "light": "/images/packet-light.png",
    "dark": "/images/packet.png"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/renderintents"
    }
  },
  "background": {
    "color": {
      "light": "#ebd3e8",
      "dark": "#0e0411"
    },
    "decoration": "grid"
  },
  "thumbnails": {
    "appearance": "dark",
    "background": "/images/amazing-4k-winter-uthdgamx86mif2r6.jpg"
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "source": "https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap",
    "family": "Google Sans",
    "weight": 400,
    "format": "woff"
  }
}
